{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rootDir": ".",
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@core/*": ["./core/*"],
      "@comp/*": ["./core/components/*"],
      "@amos/*": ["./core/plugins/amos/*"],
      "@hakushi/*": ["./core/plugins/hakushi/*"],
      "@hutao/*": ["./core/plugins/hutao/*"],
      "@nanoka/*": ["./core/plugins/nanoka/*"],
      "@yatta/*": ["./core/plugins/yatta/*"],
      "@utils/*": ["./core/utils/*"],
      "@tools/*": ["./core/tools/*"]
    }
  },
  "include": [
    "*.json",
    "config/**/*",
    "core/**/*",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "web/**/*.ts"
  ],
  "exclude": ["node_modules", ".github"]
}
