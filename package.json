{
  "name": "tg-assistant",
  "version": "2.6.0",
  "description": "The assistant for TeyvatGuide",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "resize": "tsx scripts/resizeImages.ts",
    "auto:update": "tsx ./scripts/updateAll.ts",
    "move": "tsx scripts/moveSrc.ts",
    "prepare": "husky",
    "install:amos": "pnpm add github:yuehaiteam/amos-data"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "lint-staged": {
    "*.ts": "oxlint",
    "*.{ts,json,yml}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": "prettier --write"
  },
  "keywords": [
    "BTMuli",
    "Genshin",
    "Tools"
  ],
  "author": "BTMuli <bt-muli@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/BTMuli/TGAssistant.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/BTMuli/TGAssistent#readme",
  "bugs": {
    "url": "https://github.com/BTMuli/TGAssistent/issues"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@yuehaiteam/amos-data": "github:yuehaiteam/amos-data",
    "ajv": "^8.20.0",
    "app-root-path": "^3.1.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "date-fns": "^4.4.0",
    "fs-extra": "^11.4.1",
    "geetest": "^4.1.2",
    "image-size": "^2.0.4",
    "js-md5": "^0.9.2",
    "log4js": "^6.9.1",
    "sharp": "^0.35.4",
    "uuid": "^14.0.2",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "@types/uuid": "^11.0.0",
    "@types/yamljs": "^0.2.34",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-yml": "^3.8.1",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.1",
    "yaml-eslint-parser": "^2.1.0"
  }
}
